VITE_APP_DEMO=false
VITE_APP_NATIVE=false

VITE_APP_YANDEX=true
# Yandex sources the real game id from the iframe context (ysdk.environment.app.id)
# at runtime — this env var is informational only (used in logs / debug). Set it to
# the id shown in the Yandex Games developer console so QA reports surface the right
# title.
VITE_GAME_ID=

# The gitignored dev `.env` defaults to CrazyGames (so `pnpm dev` runs as CG).
# `.env.<mode>.local` wins over `.env`, so disable the other platform flags here
# to guarantee a clean Yandex build even when your local `.env` still has them on.
# (The other platform builds rely on you toggling `.env` manually — this one is
# self-contained.)
VITE_APP_GAMEPIX=false
VITE_APP_GAME_MONETIZE=false
VITE_APP_PLAYGAMA=false
VITE_APP_GAME_DISTRIBUTION=false
VITE_APP_CRAZY_WEB=false
VITE_APP_CRAZY_GAMES_FULL_RELEASE=false

VITE_NODE_ENV=production
VITE_ENABLE_OBFUSCATION=true
