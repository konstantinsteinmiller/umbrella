# Art pipeline: originals the slicer displaced when a repaint was filed. Local
# safety copies only — the art in public/ is the source of truth.
/art-sheets/painted/replaced/

# Wrangler's local state (the leaderboard Worker's local D1 sqlite, bundles).
# Ignored for git AND for Tailwind's source scan, which honours .gitignore —
# otherwise every local D1 write rebuilt the CSS and bounced the dev page.
.wrangler

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local
*.env
.env
.env.*
# Non-secret build state checked in so multiple dev machines stay in
# sync (Android versionCode counter — Play Console rejects re-uploads
# of the same code, so the latest value MUST be committed).
!.env.tauri.remote

