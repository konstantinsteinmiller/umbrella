VITE_APP_DEMO=false
VITE_APP_NATIVE=false

VITE_APP_GAME_MONETIZE=true
VITE_GAME_ID=l46gje3eecrpgamxnhzgz92gkic07mz1

# The gitignored dev `.env` defaults to CrazyGames (so `pnpm dev` runs as CG).
# `.env.<mode>.local` wins over `.env`, so disable the CrazyGames flags here to
# guarantee a clean GameMonetize build even when your local `.env` still has them
# on. (The other platform builds rely on you toggling `.env` manually — this one
# is self-contained.)
VITE_APP_GAMEPIX=false
VITE_APP_CRAZY_WEB=false
VITE_APP_CRAZY_GAMES_FULL_RELEASE=false

VITE_NODE_ENV=production
VITE_ENABLE_OBFUSCATION=true
