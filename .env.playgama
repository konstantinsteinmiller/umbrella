# ─── Playgama — and YouTube Playables, from this same archive ──────────────
#
# Build with:  pnpm build:playgama  ->  dist/ + merge-idle-war-playgama.zip
#
# There is deliberately NO separate YouTube build. Playgama is an official
# YouTube Playables partner: one ZIP goes to developer.playgama.com and they
# distribute it to playgama.com, their partner portals AND Playables. So
# `VITE_APP_PLAYGAMA` is the only gate, and this build carries the strictest
# requirements of the set:
#
#   * no external server calls  -> Bridge v2 is bundled from the
#                                  @playgama/bridge npm package, never the CDN
#                                  script (which fetches adapter chunks at
#                                  runtime and posts to api.playgama.com)
#   * localStorage is null      -> public/js/storage-shim.js, a classic script
#                                  in <head> on every build
#   * ytgame SDK tag required   -> kept in index.html for THIS build only; the
#                                  Bridge's youtube adapter waits for
#                                  window.ytgame with no timeout
#   * no CSP meta tag           -> it would also bind YouTube's own SDK and
#                                  telemetry in the same document
#   * no Page Visibility API    -> pause + the save flush come from the
#                                  Bridge's PAUSE_STATE_CHANGED instead
#   * memory-history router     -> Playables appends #debug&origin=... to our
#                                  URL, and a hash router reads that as a route
VITE_APP_DEMO=false
VITE_APP_NATIVE=false

VITE_APP_PLAYGAMA=true

VITE_NODE_ENV=production

# OFF, deliberately. Both Playgama and YouTube review this build by hand, and
# a rejection arrives as a stack trace — chaos-arena got
# `plugin-gd-CQHccaXY.js:19:42110` in 2026-09 with no way to map it back to a
# source line, and the round trip cost a submission cycle. Minified-but-
# readable gives QA a greppable file+line, which is all that was missing.
# No source maps either: the bundle is served from a public URL and maps would
# publish the full original source next to it.
VITE_ENABLE_OBFUSCATION=false

# Belt-and-braces OFF. Vite merges `.env` with `.env.<mode>`, so any platform
# flag set in the base `.env` stays TRUE for every mode that doesn't clear it.
# `VITE_APP_CRAZY_WEB` used to live there, and because both `resolveSaveStrategy`
# and `resolveAdProvider` check the CrazyGames arm FIRST, this build silently
# became a CrazyGames one: CG save strategy + CG ad provider on a portal with no
# CG SDK, plus `persistToRaw=false` (CG cloud-only mode) wiping local state every
# boot. The flag now lives only in `.env.crazy-web`; these explicit `false`s stay
# as a guard against it being reintroduced. `vite.config.ts` also hard-fails the
# build if two platform flags are ever true at once.
VITE_APP_CRAZY_WEB=false
VITE_APP_CRAZY_GAMES_FULL_RELEASE=false

# ─── Global leaderboard: BAKED, no endpoint ─────────────────────────────────
# "No external server calls" (YouTube Playables, see the header) covers the
# leaderboard Worker too, so its URL from `.env` is emptied here. The rank tag
# still ships with the modelled board baked in (`data/leaderboard-seed.json`).
VITE_LEADERBOARD_URL=
VITE_LEADERBOARD_SECRET=
