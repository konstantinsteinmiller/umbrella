VITE_NODE_ENV=development
# Local dev must never write to the PRODUCTION leaderboard: every QA profile
# (cleared localStorage) mints a fresh player id and would post a real row.
# Empty = dev bakes the modelled board (data/leaderboard-seed.json) instead.
# To work on the live path, run the Worker locally —
#   cd worker && npx wrangler dev --port 8787 --local
# — and start the game against it (the shell variable wins over env files):
#   VITE_LEADERBOARD_URL=http://localhost:8787 pnpm dev
VITE_LEADERBOARD_URL=
