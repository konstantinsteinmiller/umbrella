{
  "name": "umbrella",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-playgama": "vite --mode playgama",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "levels:pull": "node scripts/levels-pull.mjs",
    "build:crazy-web": "vite build --mode crazy-web --base=./ ",
    "build:wavedash": "vite build --mode wavedash --base=./ --outDir=wavedash-dist && wavedash build push",
    "build:itch": "vite build --mode itch --base=./ && cd dist && tar -a -cf ../umbrella-itch.zip * && cd .. && move umbrella-itch.zip dist\\",
    "build:glitch": "vite build --mode glitch --base=./ && cd dist && tar -a -cf ../umbrella-glitch.zip * && cd .. && move umbrella-glitch.zip dist\\",
    "build:game-distribution": "vite build --mode game-distribution --base=./",
    "build:playgama": "vite build --mode playgama --base=./ && cd dist && tar -a -cf ../umbrella-playgama.zip * && cd .. && move umbrella-playgama.zip dist\\",
    "build:gamepix": "vite build --mode gamepix --base=./ && cd dist && tar -a -cf ../umbrella-gamepix.zip * && cd .. && move umbrella-gamepix.zip dist\\",
    "build:gamemonetize": "vite build --mode gamemonetize --base=./ && node tools/zip-dist.mjs umbrella-gamemonetize.zip",
    "build:yandex": "vite build --mode yandex --base=./ && cd dist && tar -a -cf ../umbrella-yandex.zip * && cd .. && move umbrella-yandex.zip dist\\",
    "build:gamepush": "vite build --mode gamepush --base=./ && node tools/zip-dist.mjs umbrella-gamepush.zip",
    "build:poki": "vite build --mode poki --base=./ && cd dist && tar -a -cf ../umbrella-poki.zip * && cd .. && move umbrella-poki.zip dist\\",
    "deploy:poki": "node tools/poki-deploy/deploy.mjs",
    "build:poki-playtest": "vite build --mode poki-playtest --base=./ && cd dist && tar -a -cf ../umbrella-poki-playtest.zip * && cd .. && move umbrella-poki-playtest.zip dist\\",
    "build:kite": "vite build --mode kite --base=/umbrella/kite/ --outDir=dist/kite",
    "build:lantern": "vite build --mode lantern --base=/umbrella/lantern/ --outDir=dist/lantern",
    "build-github-main": "vite build --base=/umbrella/ --outDir=dist",
    "build-github-develop": "vite build --base=/umbrella/develop/ --outDir=dist/develop",
    "deploy": "vite build && surge dist/ --domain umbrella.surge.sh",
    "validated-build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "leaderboard:snapshot": "node scripts/leaderboard-snapshot.mjs",
    "leaderboard:seed": "node scripts/leaderboard-seed.mjs",
    "sfx:render": "node scripts/sfx/render-new-tier-reveal.mjs",
    "sfx:skills": "node scripts/sfx/render-arena-skills.mjs",
    "art:export": "node scripts/art/export-sheets.mjs",
    "art:prompts": "node --import ./scripts/art/ts-resolve.mjs scripts/art/art-prompts.mjs",
    "art:status": "node --import ./scripts/art/ts-resolve.mjs scripts/art/art-status.mjs",
    "art:slice": "node scripts/art/slice-sheets.mjs",
    "art:measure": "python scripts/art/measure-art.py",
    "art:backdrops": "python scripts/art/backdrops.py",
    "art:desk": "node scripts/art/art-desk/server.mjs",
    "dev:kite": "vite --mode kite",
    "dev:lantern": "vite --mode lantern",
    "art:export:umbrella": "node scripts/art/export-sheets.mjs http://localhost:2050/#/art-sheets/umbrella",
    "art:prompts:umbrella": "node --import ./scripts/art/ts-resolve.mjs scripts/art/art-prompts.mjs --set umbrella",
    "art:status:umbrella": "node --import ./scripts/art/ts-resolve.mjs scripts/art/art-status.mjs --set umbrella",
    "art:slice:umbrella": "node scripts/art/slice-sheets.mjs --set umbrella --quality 0.88",
    "art:prompts:lantern": "node --import ./scripts/art/ts-resolve.mjs scripts/art/art-prompts.mjs --set umbrella-lantern",
    "art:slice:lantern": "node scripts/art/slice-sheets.mjs --set umbrella-lantern --quality 0.88",
    "art:measure:umbrella": "python scripts/art/measure-art.py frames --set umbrella",
    "art:desk:umbrella": "node scripts/art/umbrella-desk/server.mjs",
    "art:promotion": "node --import ./scripts/art/ts-resolve.mjs scripts/art/art-promotion.mjs",
    "preview:video": "node tools/preview-video/record.mjs",
    "playtest:start": "node tools/playtest/start-players.mjs",
    "playtest:stop": "node tools/playtest/stop-players.mjs",
    "playtest:report": "node tools/playtest/build-report.mjs"
  },
  "dependencies": {
    "@playgama/bridge": "^2.1.0",
    "@vueuse/core": "^14.2.1",
    "@wvdsh/sdk-js": "^0.0.38",
    "lil-gui": "0.20.0",
    "lodash.clonedeep": "^4.5.0",
    "vue": "^3.5.29",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/language-plugin-pug": "^3.2.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.8",
    "pug": "^3.0.3",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^25.5.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
