VITE_APP_TITLE=Merge Idle War
VITE_APP_REMOTE_URL=

#VITE_APP_PLAYGAMA=true
#VITE_APP_GAMEPIX=true
#VITE_APP_CRAZY_WEB=true
#VITE_APP_CRAZY_GAMES_FULL_RELEASE=true

# --- Global leaderboard (rank tag in the arena corner) -----------------------
# The Cloudflare Worker in worker/ (see worker/SETUP.md). Root .env loads for
# EVERY build mode, so this one line switches the live board on everywhere;
# the builds that may make no external request (Poki, Yandex, Playgama) empty
# it in their own env file and bake the modelled board instead.
VITE_LEADERBOARD_URL=https://merge-idle-war-leaderboard.rodent-race.workers.dev
# Optional HMAC for POST /score - set together with `wrangler secret put
# SCORE_SECRET` in worker/, or leave both unset (either order rolls out safely).
VITE_LEADERBOARD_SECRET=


# ─── Painted art overrides ───
# OFF by default, and off in every platform env until the paintings are in:
# a portal QA console reports every missed probe as a broken resource. Use
# ?art=on in the URL to try the paintings on one device without a rebuild.
# See art-sheets/README.md.
VITE_ENABLE_ART_OVERRIDES=true