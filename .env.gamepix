VITE_APP_DEMO=false
VITE_APP_NATIVE=false

VITE_APP_GAMEPIX=true

VITE_NODE_ENV=production
# Obfuscation disabled for GamePix: it adds no eval (verified) so it isn't the
# ad blocker, but turning it off shrinks the bundle, speeds asset loading, and
# rules obfuscation out entirely while debugging the GamePix test-env 403s.
# GamePix hosts the game, so IP-protection obfuscation matters less here.
VITE_ENABLE_OBFUSCATION=false
