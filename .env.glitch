VITE_APP_DEMO=false
VITE_APP_NATIVE=false

VITE_APP_GLITCH=true
# fill with the test/install/token ids issued by glitch.fun before bundling
VITE_APP_GLITCH_TEST_INSTALL_ID=6439ba38-3d6c-4eb5-a4ab-9c8d7c99b05e
VITE_APP_GLITCH_INSTALL_ID=f81545fc-99b4-4a67-880c-4fd4c2b44b26
VITE_APP_GLITCH_TOKEN=f05906e5-307b-4d82-aa3f-b5f324bac56e.5n8VnZHmmuIbDPSXlT1Ks7u7yzN6UQd8

VITE_NODE_ENV=production
VITE_ENABLE_OBFUSCATION=true

# Belt-and-braces OFF. Vite merges `.env` with `.env.<mode>`, so any platform
# flag set in the base `.env` stays TRUE for every mode that doesn't clear it.
# `VITE_APP_CRAZY_WEB` used to live there, and because both `resolveSaveStrategy`
# and `resolveAdProvider` check the CrazyGames arm FIRST, this build silently
# became a CrazyGames one: CG save strategy + CG ad provider on a portal with no
# CG SDK, plus `persistToRaw=false` (CG cloud-only mode) wiping local state every
# boot. The flag now lives only in `.env.crazy-web`; these explicit `false`s stay
# as a guard against it being reintroduced. `vite.config.ts` also hard-fails the
# build if two platform flags are ever true at once.
VITE_APP_CRAZY_WEB=false
VITE_APP_CRAZY_GAMES_FULL_RELEASE=false
